{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "wallpaper-native",
  "description": "Native wallpaper commands restricted to the official request origin.",
  "local": false,
  "webviews": ["pake", "pake-*"],
  "remote": { "urls": ["https://wallpaper.061129.xyz"] },
  "permissions": [
    "allow-wallpaper-capabilities",
    "allow-wallpaper-apply",
    "allow-wallpaper-restore",
    "allow-wallpaper-configure-rotation",
    "allow-wallpaper-rotation-status",
    "allow-wallpaper-cache-list",
    "allow-wallpaper-cache-thumbnail",
    "allow-wallpaper-cache-apply",
    "allow-wallpaper-cache-reveal",
    "allow-wallpaper-cache-delete",
    "allow-wallpaper-cache-clear-unused",
    "allow-wallpaper-storage-choose"
  ]
}
